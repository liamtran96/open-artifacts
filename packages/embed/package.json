{
  "name": "@open-artifacts/embed",
  "version": "0.0.0",
  "description": "Plain JavaScript mounting, default editor UI with replaceable slots, adapter lifecycle, and preview hosting.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-artifacts/core": "workspace:*"
  },
  "browserslist": [
    "extends ../../.browserslistrc"
  ]
}
