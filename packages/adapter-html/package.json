{
  "name": "@open-artifacts/adapter-html",
  "version": "0.0.0",
  "description": "GrapesJS project editing, supported operations, sanitizer, and HTML/CSS export for the html artifact kind.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-artifacts/core": "workspace:*"
  },
  "browserslist": [
    "extends ../../.browserslistrc"
  ]
}
